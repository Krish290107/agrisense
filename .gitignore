# Local configuration and credentials; examples are safe to commit.
.env
.env.*
!.env.example
*.pem
*.key
.aws/
.codex/
.agents/

# Local runtimes, dependencies, and Python caches.
.tools/
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Builds, deployment state, logs, and local verification artifacts.
.next/
out/
build/
dist/
.vercel/
coverage/
.coverage
.coverage.*
htmlcov/
*.tsbuildinfo
*.log
*.tmp
*.swp
*.swo
.artifacts/

# Data and generated models stay local; keep the directory placeholders.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Row-level samples and detailed coverage stay local; commit compact reports only.
reports/data/local/
# Also protect row-level outputs when --output-dir selects another folder.
**/local/samples.json
**/local/file_profiles.json
**/local/series_coverage.csv
**/local/rejected_rows.csv
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
