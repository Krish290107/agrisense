# Data and generated models stay local; keep the directory placeholders.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.keras
ml/models/

