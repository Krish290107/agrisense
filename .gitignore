# Local configuration and credentials; examples are safe to commit.
.env
.env.*
!.env.example
*.pem
*.key
.aws/
.codex/
.agents/

# Local runtimes, dependencies, and Python caches.
.tools/
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Builds, deployment state, logs, and local verification artifacts.
.next/
out/
build/
dist/
.vercel/
coverage/
*.tsbuildinfo
*.log
